#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&caps_word {
    continue-list = <MINUS UNDERSCORE QUOTE>;
};

/ {

    behaviors {
        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_0";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_DISC 0>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_1";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_DISC 1>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_2";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&bt BT_DISC 2>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_3";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&bt BT_DISC 3>;
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_4";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&bt BT_DISC 4>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <0>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        caps_word_lock: caps_word_lock {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPS_WORD_LOCK";
            bindings = <&kp CAPSLOCK>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none            &kp PERIOD       &hrm RIGHT_ALT COMMA  &kp SEMI       &kp P         &kp Y         &kp F             &kp G         &kp C         &hrm RIGHT_ALT H  &kp L             &none
&caps_word_lock  &hrm LEFT_GUI A  &hrm LEFT_ALT O       &hrm LCTRL E   &hrm LSHFT U  &kp I         &kp D             &hrm RSHFT R  &hrm RCTRL T  &hrm LALT N       &hrm RIGHT_GUI S  &kp SQT
&mo 6            &kp SLASH        &kp Q                 &kp J          &kp K         &kp X         &kp B             &kp M         &kp W         &kp V             &kp Z             &none
                                                        &ltq 2 ESCAPE  &ltq 1 SPACE  &ltq 3 TAB    &ltq 5 BACKSPACE  &ltq 4 ENTER  &kp DELETE
            >;
        };

        nav {
            bindings = <
&none  &none     &kp RALT  &none      &none      &none    &kp LC(Z)       &kp LC(V)       &kp LC(C)     &kp LC(X)  &kp LC(Y)   &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp INSERT  &none
&none  &none     &none     &none      &none      &none    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END    &none       &none
                           &none      &none      &none    &kp BSPC        &kp ENTER       &kp DELETE
            >;
        };

        media {
            bindings = <
&none  &none         &kp RALT  &none      &none      &none    &none       &none             &none         &none       &none         &none
&none  &kp LEFT_GUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp C_PREV  &kp C_VOL_DN      &kp C_VOL_UP  &kp C_NEXT  &out OUT_TOG  &none
&none  &none         &none     &none      &none      &none    &bt_0       &bt_1             &bt_2         &bt_3       &bt_4         &none
                               &none      &none      &none    &kp C_STOP  &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };

        mouse {
            bindings = <
&none  &none     &kp RALT  &none      &none      &none    &kp LC(Z)       &kp LC(V)       &kp LC(C)     &kp LC(X)        &kp LC(Y)  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB4   &none
&none  &none     &none     &none      &none      &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &mkp MB5   &none
                           &none      &none      &none    &mkp RCLK       &mkp LCLK       &mkp MCLK
            >;
        };

        num {
            bindings = <
&none  &kp APOS              &kp N7  &kp N8     &kp N9  &kp NON_US_HASH    &none  &none      &none      &kp RALT  &none     &none
&none  &kp LBKT              &kp N4  &kp N5     &kp N6  &kp RBKT           &none  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI  &none
&none  &kp NON_US_BACKSLASH  &kp N1  &kp N2     &kp N3  &kp GRAVE          &none  &none      &kp COMMA  &kp DOT   &kp FSLH  &none
                                     &kp EQUAL  &kp N0  &kp MINUS          &none  &none      &none
            >;
        };

        sym {
            bindings = <
&none  &kp RA(APOS)         &kp LS(N7)  &kp LS(N8)     &kp LS(N9)  &kp RA(NON_US_HASH)    &none  &none      &none      &kp RALT  &none     &none
&none  &kp RA(LBKT)         &kp LS(N4)  &kp LS(N5)     &kp LS(N6)  &kp RA(RBKT)           &none  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI  &none
&none  &kp LS(NON_US_BSLH)  &kp LS(N1)  &kp LS(N2)     &kp LS(N3)  &kp RA(GRAVE)          &none  &none      &none      &none     &none     &none
                                        &kp LS(EQUAL)  &kp LS(N0)  &kp LS(MINUS)          &none  &none      &none
            >;
        };

        magic {
            bindings = <
&bootloader  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &bootloader
&sys_reset   &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &sys_reset
&none        &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                           &none  &none  &none    &none  &none  &none
            >;
        };
    };
};
